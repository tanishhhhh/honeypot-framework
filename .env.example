# ── Flask ──────────────────────────────────────
FLASK_DEBUG=false

# ── Email Alerting ────────────────────────────
# Required: Gmail App Password (not your regular password)
# See EMAIL_SETUP.md for instructions on generating one.
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=honeytest777@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Splunk SIEM (primary) ─────────────────────
SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector
SPLUNK_HEC_TOKEN=your-hec-token

# ── Elasticsearch SIEM (fallback) ─────────────
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX=honeypot-alerts

# ── Database ──────────────────────────────────
DB_URL=postgresql://admin:admin123@db:5432/honeypot
